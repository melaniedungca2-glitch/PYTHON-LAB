current_quiz = []
current_question = 0
current_score = 0
quiz_active = False


def show_quiz_categories():

    clear_content()
    show_frame(content_frame)

    make_title("QUIZ CENTER")

    for category in quiz_questions:

        tk.Button(
            content_frame,
            text=category + " QUIZ",
