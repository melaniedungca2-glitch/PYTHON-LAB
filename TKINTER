prediction_index = 0


def show_prediction_menu():

    global prediction_index

    prediction_index = 0
    show_prediction_question()


def show_prediction_question():

    clear_content()
    show_frame(content_frame)

    make_title("GUESS THE OUTPUT")

    if prediction_index >= len(prediction_questions):

        tk.Label(
            content_frame,
            text="YOU FINISHED ALL QUESTIONS!",
            fg=LIME,
            bg=BG,
            font=("Arial", 16, "bold")
        ).pack(pady=40)

        tk.Button(
            content_frame,
            text="BACK TO DASHBOARD",
            bg=CYAN,
            fg=BG,
            command=back_to_dashboard
        ).pack()

        return

    code, answer = prediction_questions[prediction_index]

    tk.Label(
        content_frame,
        text="What will this code display?",
        fg=WHITE,
        bg=BG,
        font=("Arial", 13)
    ).pack(pady=15)

    tk.Label(
        content_frame,
        text=code,
        fg=CYAN,
        bg=PANEL,
        font=("Courier", 14),
        padx=20,
        pady=20
    ).pack(pady=15)

    answer_entry = tk.Entry(
        content_frame,
        font=("Arial", 13),
        justify="center",
        width=30
    )
    answer_entry.pack(pady=10)

    def check_prediction():

        global prediction_index

        if answer_entry.get().strip() == answer:

            messagebox.showinfo("Result", "Correct!")
        else:

            messagebox.showinfo(
                "Result",
                "Correct output:\n" + answer
            )

        prediction_index += 1
        show_prediction_question()

    tk.Button(
        content_frame,
        text="CHECK ANSWER",
        bg=LIME,
        fg=BG,
        command=check_prediction
    ).pack(pady=10)

    tk.Button(
        content_frame,
        text="BACK TO DASHBOARD",
        bg=CYAN,
        fg=BG,
        command=back_to_dashboard
    ).pack(pady=5)


