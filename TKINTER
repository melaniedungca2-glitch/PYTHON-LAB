        content_frame,
        text="BACK TO DASHBOARD",
        bg=CYAN,
        fg=BG,
        command=back_to_dashboard
    ).pack(pady=15)


def start_quiz(category):

    global current_quiz
    global current_question
    global current_score
    global quiz_active

    current_quiz = quiz_questions[category]
    current_question = 0
    current_score = 0
    quiz_active = True

    show_question(category)


def show_question(category):

    clear_content()
    show_frame(content_frame)

    question = current_quiz[current_question]

    make_title(category + " QUIZ")

    tk.Label(
        content_frame,
        text="Question " + str(current_question + 1)
        + " of " + str(len(current_quiz)),
        fg=CYAN,
        bg=BG,
        font=("Arial", 12)
    ).pack(pady=10)

    tk.Label(
        content_frame,
        text=question[0],
        fg=WHITE,
        bg=BG,
        font=("Arial", 14, "bold"),
        wraplength=750
    ).pack(pady=20)

    for choice in question[1]:

        tk.Button(
            content_frame,
            text=choice,
            bg=PANEL,
            fg=WHITE,
            width=40,
            height=2,
            command=lambda answer=choice[0]:
            check_answer(answer, category)
        ).pack(pady=5)


def check_answer(answer, category):

    global current_score
    global current_question

    if answer == current_quiz[current_question][2]:
        current_score += 1
        messagebox.showinfo("Result", "Correct answer!")
    else:
        messagebox.showinfo(
            "Result",
            "Incorrect! Correct answer: "
            + current_quiz[current_question][2]
        )

    current_question += 1

    if current_question < len(current_quiz):
        show_question(category)
    else:
        finish_quiz(category)


def finish_quiz(category):

    global quiz_active

    quiz_active = False

    total = len(current_quiz)

    quiz_scores.append({
        "name": student_name,
        "category": category,
        "score": current_score,
        "total": total
    })

    clear_content()
    show_frame(content_frame)

    make_title("QUIZ COMPLETED!")

    tk.Label(
        content_frame,
        text="Student: " + student_name,
        fg=WHITE,
        bg=BG,
        font=("Arial", 13)
    ).pack(pady=10)

    tk.Label(
        content_frame,
        text="Your Score: " + str(current_score)
        + " / " + str(total),
        fg=CYAN,
        bg=BG,
        font=("Arial", 22, "bold")
    ).pack(pady=20)

    tk.Button(
        content_frame,
        text="BACK TO QUIZ CENTER",
        bg=LIME,
        fg=BG,
        command=show_quiz_categories
    ).pack(pady=10)

    tk.Button(
        content_frame,
        text="BACK TO DASHBOARD",
        bg=CYAN,
        fg=BG,
        command=back_to_dashboard
    ).pack(pady=5)
    
